<?xml version="1.0" encoding="utf-8"?>
<!--
    The platform theme. It only has to survive from process start until the
    first Compose frame — NimboTheme (Material 3, in Compose) supplies the real
    look. The parent is a *framework* theme on purpose: com.google.android.material
    is not in the pinned dependency set, so Theme.MaterialComponents.* and
    Theme.AppCompat.* are not available here.

    The bar colours here only last as long as that first frame: MainActivity
    turns on edge-to-edge and colours the system bars from the resolved theme.
    The dark variant is values-night/themes.xml.
-->
<resources>

    <style name="Theme.Nimbo" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorPrimary">@color/brand_accent</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/brand_accent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
